{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oidc-exchange.dev/specs/service/canonical-types.schema.json",
  "title": "oidc-exchange service canonical types",
  "description": "Domain entities of crates/core. Shared primitives are referenced from the repo-wide schema at ../../canonical-types.schema.json.",
  "$defs": {
    "UserStatus": {
      "type": "string",
      "enum": ["active", "suspended", "deleted"]
    },
    "User": {
      "type": "object",
      "required": ["id", "external_id", "provider", "metadata", "claims", "status", "version", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "../../canonical-types.schema.json#/$defs/Id" },
        "external_id": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString", "description": "Provider sub claim or DID." },
        "provider": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "email": { "type": ["string", "null"], "format": "email" },
        "display_name": { "type": ["string", "null"] },
        "metadata": { "type": "object", "additionalProperties": true, "description": "Extensible sync/profile data; readable by claim templates." },
        "claims": { "type": "object", "additionalProperties": true, "description": "Per-user private claims merged into the access token JWT." },
        "status": { "$ref": "#/$defs/UserStatus" },
        "version": { "type": "integer", "minimum": 1, "description": "Optimistic-concurrency counter; starts at 1 on create, incremented by every update_user." },
        "created_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp" },
        "updated_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp" }
      }
    },
    "NewUser": {
      "type": "object",
      "required": ["external_id", "provider"],
      "properties": {
        "external_id": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "provider": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "email": { "type": ["string", "null"], "format": "email" },
        "display_name": { "type": ["string", "null"] }
      }
    },
    "UserPatch": {
      "type": "object",
      "description": "All fields optional; a present claims map REPLACES the whole claims set.",
      "properties": {
        "email": { "type": ["string", "null"], "format": "email" },
        "display_name": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"], "additionalProperties": true },
        "claims": { "type": ["object", "null"], "additionalProperties": true },
        "status": { "oneOf": [{ "$ref": "#/$defs/UserStatus" }, { "type": "null" }] }
      }
    },
    "Session": {
      "type": "object",
      "description": "One generation of a refresh-token family.",
      "required": ["user_id", "refresh_token_hash", "family_id", "generation", "provider", "expires_at", "created_at"],
      "properties": {
        "user_id": { "$ref": "../../canonical-types.schema.json#/$defs/Id" },
        "refresh_token_hash": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString", "description": "SHA-256 hex of the opaque refresh token." },
        "family_id": { "$ref": "../../canonical-types.schema.json#/$defs/Id", "description": "fam_<lowercase ulid>; stable across every rotation of one sign-in." },
        "generation": { "type": "integer", "minimum": 0, "description": "0 at exchange, incremented once per rotation." },
        "provider": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "expires_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp", "description": "Absolute family deadline; set at exchange and never moved by rotation." },
        "rotated_at": { "type": ["string", "null"], "format": "date-time", "description": "When this generation was issued; null at generation 0." },
        "device_id": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "ip_address": { "type": ["string", "null"] },
        "created_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp", "description": "When the family was created." }
      }
    },
    "RetiredRefreshToken": {
      "type": "object",
      "description": "A retired refresh-token generation, retained so that its re-presentation is detectable as reuse.",
      "required": ["refresh_token_hash", "family_id", "user_id", "successor_hash", "retired_at", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "refresh_token_hash": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "family_id": { "$ref": "../../canonical-types.schema.json#/$defs/Id" },
        "user_id": { "$ref": "../../canonical-types.schema.json#/$defs/Id" },
        "successor_hash": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString", "description": "The generation that replaced this one. Grace applies only while this is still the family's live generation." },
        "retired_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp" },
        "expires_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp", "description": "min(retired_at + token.refresh_reuse_retention, family expires_at)." }
      }
    },
    "SingleUseRecord": {
      "type": "object",
      "required": ["key", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString",
          "description": "Namespaced digest: 'nonce:<sha256hex>' or 'assertion:<provider>:[d:]<sha256hex>'. Never a raw nonce or assertion."
        },
        "expires_at": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp" }
      }
    },
    "TokenResponse": {
      "type": "object",
      "required": ["access_token", "token_type", "expires_in"],
      "properties": {
        "access_token": { "type": "string" },
        "refresh_token": { "type": ["string", "null"], "description": "Present on exchange and on refresh; null on refresh only when token.refresh_rotation is false." },
        "token_type": { "type": "string", "const": "Bearer" },
        "expires_in": { "type": "integer", "minimum": 0, "description": "Seconds until the access token expires." }
      }
    },
    "AccessTokenClaims": {
      "type": "object",
      "description": "JWT payload. custom claims are flattened alongside the registered claims.",
      "required": ["sub", "iss", "aud", "iat", "exp", "sid"],
      "properties": {
        "sub": { "$ref": "../../canonical-types.schema.json#/$defs/Id" },
        "iss": {
          "type": "string",
          "minLength": 1,
          "description": "server.issuer; required non-empty at config load, so an empty iss is unrepresentable."
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "description": "Single audience string (no array). token.audience; required non-empty at config load."
        },
        "sid": {
          "type": "string",
          "pattern": "^fam_[0-9a-z]{26}$",
          "description": "Session identifier: the family_id of the session this access token was minted for. Stable across refresh-token rotation; names the only session (token family) the token may revoke."
        },
        "iat": { "type": "integer" },
        "exp": { "type": "integer" },
        "sid": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Session identifier: the SHA-256 hex refresh_token_hash of the session this access token was minted for. Names the only session the token may revoke."
        }
      },
      "additionalProperties": true
    },
    "ProviderTokens": {
      "type": "object",
      "required": ["id_token"],
      "properties": {
        "id_token": { "type": "string" },
        "refresh_token": { "type": ["string", "null"] },
        "access_token": { "type": ["string", "null"] }
      }
    },
    "IdentityClaims": {
      "type": "object",
      "required": ["subject", "signing_alg", "raw_claims"],
      "properties": {
        "subject": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString", "description": "Provider sub / DID." },
        "email": { "type": ["string", "null"], "format": "email" },
        "email_verified": { "type": ["boolean", "null"] },
        "name": { "type": ["string", "null"] },
        "is_private_email": {
          "type": ["boolean", "null"],
          "description": "Apple private-relay flag, coerced bool-or-string like email_verified; null for non-Apple providers."
        },
        "signing_alg": {
          "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString",
          "description": "JWS algorithm the resolved JWK verified the ID token with (never the untrusted header's). Selects the at_hash digest."
        },
        "raw_claims": { "type": "object", "additionalProperties": true }
      }
    },
    "ExchangeCredential": {
      "description": "The typed form of the declared grant_type on POST /token. Exactly one variant; each owns its grant's required parameters.",
      "oneOf": [
        {
          "type": "object",
          "title": "AuthorizationCode",
          "required": ["grant_type", "code", "redirect_uri"],
          "additionalProperties": false,
          "properties": {
            "grant_type": { "const": "authorization_code" },
            "code": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
            "redirect_uri": { "$ref": "../../canonical-types.schema.json#/$defs/Url" }
          }
        },
        {
          "type": "object",
          "title": "IdTokenAssertion",
          "required": ["grant_type", "id_token"],
          "additionalProperties": false,
          "properties": {
            "grant_type": { "const": "id_token" },
            "id_token": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" }
          }
        }
      ]
    },
    "ExchangeRequest": {
      "type": "object",
      "description": "Input to AppService::exchange. No default construction: credential and provider are always present.",
      "required": ["credential", "provider"],
      "additionalProperties": false,
      "properties": {
        "credential": { "$ref": "#/$defs/ExchangeCredential" },
        "provider": { "$ref": "../../canonical-types.schema.json#/$defs/NonEmptyString" },
        "ip_address": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "device_id": { "type": ["string", "null"] }
      }
    },
    "AuditSeverity": {
      "type": "string",
      "enum": ["emergency", "alert", "critical", "error", "warning", "notice", "info", "debug"],
      "description": "RFC 5424 syslog levels; emergency is most severe."
    },
    "AuditEventType": {
      "type": "string",
      "enum": [
        "token_exchange", "token_refresh", "token_revocation", "session_revoked",
        "all_sessions_revoked", "user_created", "user_updated", "user_suspended",
        "user_deleted", "validation_failed", "registration_denied", "provider_error",
        "unauthorized", "refresh_token_reuse"
      ]
    },
    "AuditOutcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "failure"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "AuditEvent": {
      "type": "object",
      "required": ["id", "timestamp", "severity", "event_type", "detail", "outcome"],
      "properties": {
        "id": { "$ref": "../../canonical-types.schema.json#/$defs/Ulid" },
        "timestamp": { "$ref": "../../canonical-types.schema.json#/$defs/Timestamp" },
        "severity": { "$ref": "#/$defs/AuditSeverity" },
        "event_type": { "$ref": "#/$defs/AuditEventType" },
        "actor": { "type": ["string", "null"], "description": "User id if known." },
        "provider": { "type": ["string", "null"] },
        "ip_address": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "detail": { "type": "object", "additionalProperties": true },
        "outcome": { "$ref": "#/$defs/AuditOutcome" }
      }
    },
    "OidcProviderConfig": {
      "type": "object",
      "required": ["provider_id", "issuer", "client_id", "scopes"],
      "properties": {
        "provider_id": { "type": "string" },
        "issuer": { "type": "string", "description": "Used for OIDC discovery." },
        "client_id": { "type": "string" },
        "client_secret": { "type": ["string", "null"] },
        "jwks_uri": { "type": ["string", "null"] },
        "token_endpoint": { "type": ["string", "null"] },
        "revocation_endpoint": { "type": ["string", "null"] },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "additional_params": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "AdminStats": {
      "type": "object",
      "required": ["users", "sessions"],
      "properties": {
        "users": {
          "type": "object",
          "required": ["total", "active", "suspended", "deleted"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "active": { "type": "integer", "minimum": 0 },
            "suspended": { "type": "integer", "minimum": 0 },
            "deleted": { "type": "integer", "minimum": 0 }
          }
        },
        "sessions": {
          "type": "object",
          "required": ["active"],
          "properties": {
            "active": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
