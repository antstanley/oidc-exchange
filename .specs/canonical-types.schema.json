{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oidc-exchange.dev/specs/canonical-types.schema.json",
  "title": "oidc-exchange shared canonical types",
  "description": "Repo-wide types referenced by more than one package. Package-specific entities live in that package's canonical-types.schema.json and $ref this file for shared primitives.",
  "$defs": {
    "Id": {
      "type": "string",
      "description": "A prefixed ULID identifier, lowercase. Example: usr_01arz3ndektsv4rrffq69g5fav",
      "minLength": 1
    },
    "Ulid": {
      "type": "string",
      "description": "A bare ULID (used for audit event ids).",
      "minLength": 26,
      "maxLength": 26
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 / ISO 8601 UTC timestamp."
    },
    "Email": {
      "type": "string",
      "format": "email"
    },
    "Url": {
      "type": "string",
      "format": "uri"
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "HttpRequest": {
      "type": "object",
      "description": "Transport-agnostic wire request handed to the FFI normaliser by every binding. Hosts do not decode, strip prefixes, or deduplicate headers.",
      "required": [
        "method",
        "rawPath",
        "headers"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "rawPath": {
          "type": "string",
          "description": "Percent-encoded origin-form path without query or fragment; empty normalises to '/'."
        },
        "query": {
          "type": "string",
          "description": "Percent-encoded query without leading '?'."
        },
        "headers": {
          "type": "array",
          "description": "Ordered header pairs; duplicates preserved.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Bounded before host buffering."
        },
        "pathIsRaw": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "HttpResponse": {
      "type": "object",
      "description": "Transport-agnostic HTTP response returned by the FFI core to every binding.",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Raw response body as bytes (modelled as base64 in JSON)."
        }
      }
    },
    "OAuthErrorEnvelope": {
      "type": "object",
      "description": "RFC 6749 \u00a75.2 error body returned by the public HTTP API.",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "invalid_grant",
            "invalid_token",
            "invalid_request",
            "access_denied",
            "unauthorized",
            "unsupported_grant_type",
            "conflict",
            "server_error"
          ]
        },
        "error_description": {
          "type": "string"
        }
      }
    },
    "NormalisationLimits": {
      "type": "object",
      "required": [
        "maxBodyBytes"
      ],
      "properties": {
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum request body bytes from server.max_request_body_bytes."
        }
      }
    }
  }
}
