    "format:check": "pnpm -r --no-bail format:check",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test:supply-chain": "node --test scripts/__tests__/supply-chain.test.mjs"
  },
  "devDependencies": {
    "lefthook": "2.1.9",
    "yaml": "2.9.0"
  }
}
