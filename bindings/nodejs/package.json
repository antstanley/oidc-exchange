{
  "name": "@oidc-exchange/node",
  "version": "0.1.0",
  "description": "Node.js bindings for oidc-exchange - OIDC token exchange service",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antstanley/oidc-exchange.git",
    "directory": "bindings/nodejs"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --release --dts index.generated.d.ts",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "napi": {
    "name": "oidc-exchange",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-apple-darwin"
      ]
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@10.11.0"
}
