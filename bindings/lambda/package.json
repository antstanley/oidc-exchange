{
  "name": "@oidc-exchange/lambda",
  "version": "0.4.1",
  "description": "AWS Lambda adapter for oidc-exchange - handles API Gateway, ALB, and Function URL events",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antstanley/oidc-exchange.git",
    "directory": "bindings/lambda"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@oidc-exchange/node": "workspace:^"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@oidc-exchange/node": "^0.4.1"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@11.9.0"
}
