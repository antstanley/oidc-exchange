{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OIDC Exchange Data Model",
  "definitions": {
    "User": {
      "type": "object",
      "required": ["id", "external_id", "provider", "status", "version", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "description": "Internal user ID (e.g., usr_01ARZ3NDEK...)" },
        "external_id": { "type": "string", "description": "Provider subject claim or DID" },
        "provider": { "type": "string", "description": "Provider identifier (google, apple, atproto)" },
        "email": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Extensible key-value pairs for sync data"
        },
        "claims": {
          "type": "object",
          "additionalProperties": true,
          "description": "Per-user private claims added to access token JWT, managed via internal API"
        },
        "status": { "enum": ["active", "suspended", "deleted"] },
        "version": { "type": "integer", "minimum": 1, "description": "Optimistic-concurrency counter; starts at 1 on create, incremented by every update_user." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "Session": {
      "type": "object",
      "description": "One generation of a refresh-token family.",
      "required": ["user_id", "refresh_token_hash", "family_id", "generation", "provider", "expires_at", "created_at"],
      "properties": {
        "user_id": { "type": "string" },
        "refresh_token_hash": { "type": "string", "description": "SHA-256 hash of the opaque refresh token" },
        "family_id": { "type": "string", "description": "fam_<lowercase ulid>; stable across every rotation of one sign-in" },
        "generation": { "type": "integer", "minimum": 0, "description": "0 at exchange, incremented once per rotation" },
        "provider": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time", "description": "Absolute family deadline; set at exchange and never moved by rotation." },
        "rotated_at": { "type": ["string", "null"], "format": "date-time", "description": "When this generation was issued; null at generation 0." },
        "device_id": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "ip_address": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "RetiredRefreshToken": {
      "type": "object",
      "description": "A retired refresh-token generation, retained so that its re-presentation is detectable as reuse.",
      "required": ["refresh_token_hash", "family_id", "user_id", "successor_hash", "retired_at", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "refresh_token_hash": { "type": "string", "description": "SHA-256 hash of the retired generation" },
        "family_id": { "type": "string" },
        "user_id": { "type": "string" },
        "successor_hash": { "type": "string", "description": "The generation that replaced this one. Grace applies only while this is still the family's live generation." },
        "retired_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time", "description": "min(retired_at + token.refresh_reuse_retention, family expires_at)." }
      }
    },
    "AuditEvent": {
      "type": "object",
      "required": ["id", "timestamp", "severity", "event_type", "ip_address_source", "outcome"],
      "properties": {
        "id": { "type": "string", "description": "ULID" },
        "timestamp": { "type": "string", "format": "date-time" },
        "severity": { "enum": ["emergency", "alert", "critical", "error", "warning", "notice", "info", "debug"] },
        "event_type": { "enum": ["token_exchange", "token_refresh", "token_revocation", "session_revoked", "all_sessions_revoked", "user_created", "user_updated", "user_suspended", "user_deleted", "validation_failed", "registration_denied", "provider_error", "unauthorized", "throttle_exceeded", "refresh_token_reuse", "missing_credential", "invalid_credential", "not_configured"] },
        "actor": { "type": ["string", "null"], "description": "User ID if known" },
        "provider": { "type": ["string", "null"] },
        "operator": {
          "description": "The authenticated operator behind an /internal/* admin mutation; absent (None) on the exchange plane.",
          "anyOf": [{ "$ref": "#/definitions/OperatorPrincipal" }, { "type": "null" }]
        },
        "ip_address": { "type": ["string", "null"] },
        "ip_address_source": { "enum": ["peer", "forwarded", "asserted", "unknown"] },
        "user_agent": { "type": ["string", "null"] },
        "detail": { "type": "object", "additionalProperties": true },
        "outcome": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["success", "failure"] },
            "reason": { "enum": ["authentication_failed", "registration_denied", "principal_suspended", "provider_rejected", "throttle_exceeded", "refresh_token_reuse", "missing_credential", "invalid_credential", "not_configured", null] }
          }
        }
      }
    },
    "OperatorAuthMechanism": {
      "type": "string",
      "enum": ["mtls", "operator_token", "shared_secret"],
      "description": "How an /internal/* request was authenticated."
    },
    "OperatorPrincipal": {
      "type": "object",
      "description": "The authenticated identity behind an /internal/* request, recorded on admin audit events. Never carries credential material.",
      "required": ["id", "mechanism"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Certificate subject, operator-token sub, or the reserved literal 'unattributed'" },
        "mechanism": { "$ref": "#/definitions/OperatorAuthMechanism" }
      }
    },
    "SingleUseRecord": {
      "type": "object",
      "required": ["key", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "description": "Namespaced digest key ('nonce:<sha256hex>' or 'assertion:<provider>:[d:]<sha256hex>'); never a raw nonce or raw assertion." },
        "expires_at": { "type": "string", "format": "date-time", "description": "Instant after which both claim operations treat the record as absent." }
      }
    }
  }
}
