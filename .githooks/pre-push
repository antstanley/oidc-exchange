#!/bin/sh
#
# pre-push — run the project's per-language quality gates before a push.
#
# This is a Git pre-push hook. Git invokes it with the push's refs on stdin,
# one line per ref:  <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# It maps the changed files to the language gates documented in CONTRIBUTING.md
# and .github/workflows/ci.yml, and runs only the gate(s) for the language(s)
# that actually changed. When the changed-file set cannot be determined it runs
# ALL gates — it never decides to run nothing on uncertain input. On the first
# failing gate command it prints the failure and exits non-zero, blocking the
# push.
#
#   Gates (commands taken verbatim from CI):
#     Rust   (at repo root):        cargo fmt --check
#                                   cargo clippy --workspace -- -D warnings
#                                   cargo nextest run --workspace
#     Node   (in bindings/nodejs):  pnpm fmt:check
#                                   pnpm lint
#                                   pnpm test
#     Python (in bindings/python):  uv run ruff format --check .
#                                   uv run ruff check .
#                                   uv run pytest
#
# IMPORTANT (jj caveat): `jj git push` does NOT run Git hooks. This hook only
# fires when pushing through the Git CLI / Git backend. It is therefore an
# opt-in, git-backend / manual-run convenience; CI remains the real backstop.
# Activate it with:  git config core.hooksPath .githooks
#
# Testing aid: set PRE_PUSH_DRY_RUN=1 to print the gate commands that WOULD run
# (with their working directory) instead of executing them. The default, with
# the variable unset, runs the real commands.

set -e

# ---------------------------------------------------------------------------
# Locate the repository root. Git sets cwd to the worktree root when it invokes
# the hook; fall back to the current directory when run by hand outside Git
# (e.g. inside a jj workspace where `git` cannot see the repo).
# ---------------------------------------------------------------------------
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=""
[ -n "$REPO_ROOT" ] || REPO_ROOT=$(pwd)

# Gate selections.
RUST=0
NODE=0
PYTHON=0
# Set to 1 when the changed set cannot be computed -> run every gate.
RUN_ALL=0
# Accumulated newline-separated list of changed paths.
CHANGED_FILES=""

ZERO_LINE='----------------------------------------------------------------------'

# Return success when $1 is an all-zeroes SHA (a deleted/new ref sentinel) or
# empty; failure otherwise.
is_zero_sha() {
	case "$1" in
		'') return 0 ;;
		*[!0]*) return 1 ;;
		*) return 0 ;;
	esac
}

# Map a single changed path to one or more gates.
classify() {
	case "$1" in
		crates/*) RUST=1 ;;
	esac
	case "$1" in
		bindings/nodejs/src/*|bindings/python/src/*) RUST=1 ;;
	esac
	case "$1" in
		Cargo.toml|Cargo.lock) RUST=1 ;;
	esac
	case "$1" in
		bindings/*/Cargo.toml) RUST=1 ;;
	esac
	case "$1" in
		bindings/nodejs/*|bindings/lambda/*) NODE=1 ;;
	esac
	case "$1" in
		bindings/python/*) PYTHON=1 ;;
	esac
}

# Compute CHANGED_FILES / RUN_ALL from the stdin push refs.
collect_changes() {
	# Without a usable Git repository we cannot scope -> run all gates.
	if ! git rev-parse --git-dir >/dev/null 2>&1; then
		RUN_ALL=1
		return 0
	fi

	cd "$REPO_ROOT" 2>/dev/null || true

	_saw_range=0
	_stdin=$(cat)

	if [ -n "$_stdin" ]; then
		# One line per ref being pushed.
		while IFS=' ' read -r _local_ref _local_sha _remote_ref _remote_sha; do
			[ -n "$_local_ref" ] || continue

			# Deleting a remote ref pushes nothing new — skip it.
			if is_zero_sha "$_local_sha"; then
				continue
			fi

			if is_zero_sha "$_remote_sha"; then
				# New branch on the remote: no remote tip to diff from.
				# Approximate with origin/main when available, else run all.
				if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null 2>&1; then
					_range="origin/main..$_local_sha"
				else
					RUN_ALL=1
					continue
				fi
			else
				_range="$_remote_sha..$_local_sha"
			fi

			if _files=$(git diff --name-only "$_range" 2>/dev/null); then
				CHANGED_FILES="$CHANGED_FILES
$_files"
				_saw_range=1
			else
				RUN_ALL=1
			fi
		done <<-EOF
			$_stdin
		EOF
	else
		# Empty stdin (manual run / no refs given): approximate the push by
		# diffing the working tree against origin/main. If that ref is missing
		# we cannot tell what changed -> run all gates.
		if git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null 2>&1; then
			if _files=$(git diff --name-only origin/main 2>/dev/null); then
				CHANGED_FILES="$_files"
				_saw_range=1
			else
				RUN_ALL=1
			fi
		else
			RUN_ALL=1
		fi
	fi

	return 0
}

# Run one gate command, honouring PRE_PUSH_DRY_RUN. On failure: report which
# gate/command failed and abort the push.
run_step() {
	_gate=$1
	_dir=$2
	shift 2
	printf 'pre-push: [%s] (cd %s) %s\n' "$_gate" "$_dir" "$*"
	if [ -n "${PRE_PUSH_DRY_RUN:-}" ]; then
		return 0
	fi
	if ! ( cd "$_dir" && "$@" ); then
		echo "$ZERO_LINE" >&2
		printf 'pre-push: GATE FAILED [%s]\n' "$_gate" >&2
		printf 'pre-push: command failed: %s\n' "$*" >&2
		printf 'pre-push: (in %s)\n' "$_dir" >&2
		printf 'pre-push: push aborted — fix the above and try again.\n' >&2
		echo "$ZERO_LINE" >&2
		exit 1
	fi
}

run_rust_gate() {
	echo "pre-push: running Rust gate"
	run_step rust "$REPO_ROOT" cargo fmt --check
	run_step rust "$REPO_ROOT" cargo clippy --workspace -- -D warnings
	run_step rust "$REPO_ROOT" cargo nextest run --workspace
}

run_node_gate() {
	echo "pre-push: running Node gate"
	run_step node "$REPO_ROOT/bindings/nodejs" pnpm fmt:check
	run_step node "$REPO_ROOT/bindings/nodejs" pnpm lint
	run_step node "$REPO_ROOT/bindings/nodejs" pnpm test
}

run_python_gate() {
	echo "pre-push: running Python gate"
	run_step python "$REPO_ROOT/bindings/python" uv run ruff format --check .
	run_step python "$REPO_ROOT/bindings/python" uv run ruff check .
	run_step python "$REPO_ROOT/bindings/python" uv run pytest
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
collect_changes

if [ "$RUN_ALL" -eq 1 ]; then
	RUST=1
	NODE=1
	PYTHON=1
	echo "pre-push: changed-file set undetermined; running ALL gates."
else
	_oldifs=$IFS
	IFS='
'
	for _f in $CHANGED_FILES; do
		[ -n "$_f" ] || continue
		classify "$_f"
	done
	IFS=$_oldifs
fi

if [ "$RUST" -eq 0 ] && [ "$NODE" -eq 0 ] && [ "$PYTHON" -eq 0 ]; then
	echo "pre-push: no Rust/Node/Python files changed; nothing to check."
	exit 0
fi

_sel=""
if [ "$RUST" -eq 1 ]; then _sel="$_sel rust"; fi
if [ "$NODE" -eq 1 ]; then _sel="$_sel node"; fi
if [ "$PYTHON" -eq 1 ]; then _sel="$_sel python"; fi
echo "pre-push: selected gates ->$_sel"

if [ "$RUST" -eq 1 ]; then
	run_rust_gate
fi
if [ "$NODE" -eq 1 ]; then
	run_node_gate
fi
if [ "$PYTHON" -eq 1 ]; then
	run_python_gate
fi

echo "pre-push: all selected gates passed."
exit 0
